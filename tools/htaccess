# Wrightson & Vale — wrightsonvale.ru
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www -> без www
  RewriteCond %{HTTP_HOST} ^www\.wrightsonvale\.ru$ [NC]
  RewriteRule ^(.*)$ https://wrightsonvale.ru/$1 [R=301,L]
  # http -> https (за Cloudflare учитываем X-Forwarded-Proto)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP:CF-Visitor} !https
  RewriteRule ^(.*)$ https://wrightsonvale.ru/$1 [R=301,L]
</IfModule>

AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
